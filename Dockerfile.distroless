FROM golang:1.27-trixie AS builder

ENV CGO_ENABLED=0 GOFLAGS="-mod=readonly"

RUN apt-get update && apt-get -y upgrade && apt-get install --no-install-recommends -y media-types && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /workspace
WORKDIR /workspace

ARG GOPROXY

COPY go.mod go.sum ./
RUN go mod download && go mod verify

ARG COMMIT_SHA

# This ARG allows to disable some optional features and it might be useful if you build the image yourself.
# For this variant we disable SQLite support since it requires CGO and so a C runtime which is not installed
# in distroless/static-* images
ARG FEATURES

COPY . .

RUN set -xe && \
    export COMMIT_SHA=${COMMIT_SHA:-$(git describe --always --abbrev=8 --dirty)} && \
    go build $(if [ -n "${FEATURES}" ]; then echo "-tags ${FEATURES}"; fi) -trimpath -ldflags "-s -w -X github.com/xrogers/gonas/v2/internal/version.commit=${COMMIT_SHA} -X github.com/xrogers/gonas/v2/internal/version.date=`date -u +%FT%TZ`" -v -o gonas

# Modify the default configuration file
RUN sed -i 's|"users_base_dir": "",|"users_base_dir": "/srv/gonas/data",|' gonas.json && \
    sed -i 's|"backups"|"/srv/gonas/backups"|' gonas.json && \
    sed -i 's|"sqlite"|"bolt"|' gonas.json

RUN mkdir /etc/gonas /var/lib/gonas /srv/gonas

FROM gcr.io/distroless/static-debian13

COPY --from=builder --chown=1000:1000 /etc/gonas /etc/gonas
COPY --from=builder --chown=1000:1000 /srv/gonas /srv/gonas
COPY --from=builder --chown=1000:1000 /var/lib/gonas /var/lib/gonas
COPY --from=builder --chown=1000:1000 /workspace/gonas.json /etc/gonas/gonas.json
COPY --from=builder /workspace/templates /usr/share/gonas/templates
COPY --from=builder /workspace/static /usr/share/gonas/static
COPY --from=builder /workspace/openapi /usr/share/gonas/openapi
COPY --from=builder /workspace/gonas /usr/local/bin/
COPY --from=builder /etc/mime.types /etc/mime.types

# Log to the stdout so the logs will be available using docker logs
ENV GONAS_LOG_FILE_PATH=""
# These env vars are required to avoid the following error when calling user.Current():
# unable to get the current user: user: Current requires cgo or $USER set in environment
ENV USER=gonas
ENV HOME=/var/lib/gonas

WORKDIR /var/lib/gonas
USER 1000:1000

CMD ["gonas", "serve"]