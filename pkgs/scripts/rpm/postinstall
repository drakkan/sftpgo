if [ $1 -eq 1 ]; then
  # Initial installation
  # replacing SFTPGo renames its user, keeping the id of the files it owns
  if /usr/share/gonas/migrate-from-sftpgo --needed; then
    /usr/share/gonas/migrate-from-sftpgo || exit 1
    MIGRATED=1
  fi
  # Add user and group
  if ! getent group gonas >/dev/null; then
    /usr/sbin/groupadd --system gonas
  fi
  if ! getent passwd gonas >/dev/null; then
    /usr/sbin/useradd --system \
      --gid gonas \
      --no-create-home \
      --home-dir /var/lib/gonas \
      --shell /sbin/nologin \
      --comment "GoNAS user" \
      gonas
  fi
  # initialize data provider, the migration already did it for the copied database
  [ -n "${MIGRATED:-}" ] || /usr/bin/gonas initprovider -c /etc/gonas
  # ensure files and folders have the appropriate permissions
  /usr/bin/chown -R gonas:gonas /etc/gonas /var/lib/gonas /srv/gonas
  /usr/bin/chmod 750 /etc/gonas /etc/gonas/env.d /var/lib/gonas /srv/gonas
  /usr/bin/chmod 640 /etc/gonas/gonas.json
fi

# rpm reapplies the packaged directory metadata on every transaction,
# restore the ownership set at install for /srv/gonas, /etc/gonas/env.d
# and /var/lib/gonas
if [ -d /srv/gonas ]; then
    /usr/bin/chown gonas:gonas /srv/gonas
    /usr/bin/chmod 750 /srv/gonas
fi

if [ -d /etc/gonas/env.d ]; then
    /usr/bin/chown gonas:gonas /etc/gonas/env.d
    /usr/bin/chmod 750 /etc/gonas/env.d
fi

if [ -d /var/lib/gonas ]; then
    /usr/bin/chown gonas:gonas /var/lib/gonas
    /usr/bin/chmod 750 /var/lib/gonas
fi

# set the cap_net_bind_service capability so the service and the CLI
# commands, such as certificate requests, can bind to privileged ports
setcap cap_net_bind_service=+ep /usr/bin/gonas || :

# reload to pick up any changes to systemd files
/bin/systemctl daemon-reload >/dev/null 2>&1 || :

# the migration stopped SFTPGo, this takes its place
if [ -n "${MIGRATED:-}" ]; then
  /bin/systemctl enable --now gonas.service >/dev/null 2>&1 || :
fi
